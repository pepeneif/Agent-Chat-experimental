# Bloque de Caddy para Agent-Chat. Sustituye el dominio y el puerto.
# Anadelo a /etc/caddy/Caddyfile y recarga:  sudo systemctl reload caddy
chat.example.com {
	reverse_proxy 127.0.0.1:8792 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
